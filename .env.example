# Copy this file to ".env" and fill in your own keys:
#
#     cp .env.example .env
#
# Never commit the real .env file (it is already listed in .gitignore).

# --- DeepSeek LLM ---------------------------------------------------------
# Get an API key at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-

# Optional. The current official DeepSeek models are:
#   deepseek-flash   (fast, inexpensive)
#   deepseek-v4-pro  (stronger)
# Older tutorials may mention the legacy name "deepseek-chat".
DEEPSEEK_MODEL=deepseek-flash

# Optional. Only change this if DeepSeek changes its endpoint.
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Tavily Web Search ----------------------------------------------------
# Get an API key at https://app.tavily.com/home
TAVILY_API_KEY=
